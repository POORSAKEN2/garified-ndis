# Copy to .env.local and fill in. Never commit real values.
# All variables are server-only. Do not add a NEXT_PUBLIC_ prefix.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Inbox that receives website enquiries (TBD by the client)
ENQUIRY_TO_EMAIL=

# Sender. Needs a domain verified in Resend.
# For local development only, onboarding@resend.dev delivers to the Resend account owner.
ENQUIRY_FROM_EMAIL="Garified Website <enquiries@garified.com.au>"

# Set to "true" on preview deployments to show sample testimonials.
# Leave unset in production.
SHOW_SAMPLE_CONTENT=
