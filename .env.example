# Copy to .env and fill in. Never commit real values.
# All variables are server-only. Do not add a NEXT_PUBLIC_ prefix.

# Google account that sends the enquiry emails (a Gmail or Google Workspace address).
GMAIL_USER=enquiries@garified.com.au

# App password for that account, NOT its normal password. Needs 2-Step Verification on.
# Create one at https://myaccount.google.com/apppasswords (spaces are fine).
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Inbox that receives website enquiries (TBD by the client). Leave blank to use GMAIL_USER.
ENQUIRY_TO_EMAIL=
